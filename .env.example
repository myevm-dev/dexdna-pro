# Server-only values. Never prefix provider keys with NEXT_PUBLIC_.
RELAY_API_KEY=
KYBER_SWAP_API_KEY=

# Required to enable trading. Choose your developer wallet and fee (1–1000 bps).
# 25 bps = 0.25%. Leave unset until you have chosen the fee policy.
APP_FEE_RECIPIENT=
APP_FEE_BPS=

# At least 32 random characters, stable across all server instances.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_SIGNING_SECRET=

APP_ORIGIN=http://localhost:3000
RELAY_REFERRER=dexdna-pro
KYBER_CLIENT_ID=dexdna-pro
KYBER_REFERRAL=

# Enable only after Kyber sets up your partner fee recipient/rate.
# Every returned fee configuration is still checked against APP_FEE_*.
KYBER_LIMIT_ENABLED=false
